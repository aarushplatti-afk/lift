{
  "name": "lift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "size": "node scripts/check-bundle-size.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rls": "node scripts/with-local-supabase.mjs vitest run -c vitest.rls.config.ts",
    "e2e": "playwright test",
    "e2e:local-supabase": "node scripts/with-local-supabase.mjs playwright test",
    "format": "prettier --write .",
    "gen:types": "supabase gen types typescript --local > src/types/database.ts",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "3.10.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "tailwindcss": "3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
